library(readxl)
library(tidyverse)
library(tidyverse)
library(gridExtra)
library(gridExtra)
library(FSA)
div.data <- read_excel('DiversityDB1.xlsx', sheet = 'Census')
n_spec <- div.data %>%
group_by(GRUP, POINT) %>%
summarise(N_spec=n_distinct(SPECIES),
VEGETATION = mean(VEGETATION),
WATER = mean(WATER),
SEALED = mean(SEALED))
n_spec <- as.data.frame(n_spec)
spec_plot1 <- n_spec %>%
ggplot(aes(y = N_spec, x = VEGETATION)) +
geom_point(size = 4,alpha = 0.7, position = position_jitter()) +
geom_smooth(method = 'lm', color = 'red4', linewidth = 2) +
theme_classic() +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
plot.tag = element_text(size = 20)) +
labs(y = 'Liczba gatunkow', x = 'Indeks roslinnosci',
tag = 'A1')
spec_plot3 <- n_spec %>%
ggplot(aes(y = N_spec, x = SEALED)) +
geom_point(size = 4,alpha = 0.7, position = position_jitter()) +
geom_smooth(method = 'lm', color = 'red4', linewidth = 2) +
theme_classic() +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
plot.tag = element_text(size = 20)) +
labs(y = 'Liczba gatunkow', x = 'Indeks powierzchni uszczelnionej',
tag = 'A2')
spec_plot <- grid.arrange(spec_plot1,
#spec_plot2,
spec_plot3, ncol = 2)
n_fam <- as.data.frame(n_fam)
n_fam <- div.data %>%
group_by(GRUP, POINT) %>%
summarise(N_fam=n_distinct(FAMILY),
VEGETATION = mean(VEGETATION),
WATER = mean(WATER),
SEALED = mean(SEALED))
