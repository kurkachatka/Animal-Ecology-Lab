TERMS <- c(
# Phi, two-class binning
"ageclass[0,1)"   = "first-year birds",
"ageclass[1,2)"   = "second-year birds",
"ageclass[2,100]" = "adults",
# p, if you renamed the covariate
"agecl_padult"    = "adult birds",
"agecl_pyoung"    = "first season after ringing",
"sexM"            = "males",
"sexF"            = "females",
"tag_typemetal"   = "metal ring",
"tag_typewingtag" = "wingtag",
"tag_typecolour"  = "colour ring",
"centreDEW"       = "ringed in Germany",
"centreNLA"       = "ringed in the Netherlands",
"Time"            = "year trend",
"vole"            = "vole abundance"
)
intercept_label <- function(terms_in_param, param) {
has <- function(p) any(grepl(p, terms_in_param))
adj <- c(
if (param == "Phi" && has("^ageclass")) "first-year",
if (param == "p"   && has("^ageclass")) "first-season",
if (param == "p"   && has("^agecl_p"))  "first-season",
if (has("^sex"))      "female",
if (has("^tag_type")) "colour-ringed"
)
loc <- if (has("^centreDEW")) "ringed in the Netherlands"
else if (has("^centreNLA")) "ringed in Germany"
else NULL
core <- if (length(adj)) paste(paste(adj, collapse = " "), "birds") else "baseline"
paste0("intercept (", core, if (!is.null(loc)) paste0(", ", loc), ")")
}
pretty_par <- function(x) {
param <- sub(":.*$", "", x)
term  <- sub("^[^:]*:", "", x)
translate <- function(t) {
parts <- strsplit(t, ":", fixed = TRUE)[[1]]
paste(ifelse(parts %in% names(TERMS), TERMS[parts], parts), collapse = " × ")
}
out    <- vapply(term, translate, character(1), USE.NAMES = FALSE)
is_int <- term == "(Intercept)"
for (p in unique(param[is_int]))
out[is_int & param == p] <- intercept_label(term[param == p], p)
out
}
plot_betas <- function(model, title, chat = NULL, drop = NULL) {
if (!inherits(model, "mark"))
stop("plot_betas() needs a single fitted model, not a marklist. ",
"Pull one out first, e.g. results$Phi.ageclass.Time.p.tag.Time",
call. = FALSE)
cap <- paste0(model$model.name,
if (!is.null(chat)) sprintf("; c-hat = %.2f", chat) else "")
d <- summary(model)$beta %>% tibble::rownames_to_column("par")
if (!is.null(drop)) d <- dplyr::filter(d, !grepl(drop, par))
d <- d %>%
mutate(
panel  = ifelse(grepl("^Phi:", par),
"Apparent survival (Φ)",
"Re-encounter probability (p)"),
panel  = factor(panel, levels = c("Apparent survival (Φ)",
"Re-encounter probability (p)")),
effect = ifelse(lcl < 0 & ucl > 0, "CI includes 0", "CI excludes 0"),
text   = pretty_par(par),
row    = factor(par, levels = rev(par))
)
print(d %>% select(par, text, estimate, lcl, ucl))   # check the labels
ggplot(d, aes(estimate, row, colour = effect)) +
geom_vline(xintercept = 0, linetype = "dotted") +
geom_errorbar(aes(xmin = lcl, xmax = ucl), width = 0) +
geom_point(size = 2.5) +
scale_y_discrete(labels = setNames(d$text, d$par)) +
scale_colour_manual(values = c("CI excludes 0" = "#1B7837",
"CI includes 0" = "grey60"),
name = NULL) +
facet_wrap(~panel, scales = "free_y", ncol = 1) +
labs(x = "Beta estimate", y = NULL, title = title, caption = cap) +
theme_minimal(base_size = 13)
}
