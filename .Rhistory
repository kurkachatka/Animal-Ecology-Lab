# ==========================================================
# 13. Determine tag type, sex and ringing center
# This uses the chick database
tag_info <- chicks %>%
group_by(bird_id) %>%
summarise(
tag_type = case_when(
any(`wingtags status` != "geen", na.rm = TRUE) ~ "wingtag",
any(`kleurringstatus` != "geen", na.rm = TRUE) ~ "colour ring",
TRUE ~ "metal ring"
),
.groups = "drop"
)
# add tag_info to the cmr database
cmr <- cmr %>%
left_join(
tag_info,
by = "bird_id"
)
# checking the number of individuals with any resightings
cmr <- cmr %>%
mutate(
resight_count = rowSums(across(all_of(as.character(years))) == 1, na.rm = TRUE) - 1
)
cmr %>%
count(resight_count)
# Add sex information from chicks
# Sex seen as an ADULT in the observations
# Chick records that say both F and M -> U.
# Sex from all chick records
sex_chick <- chicks %>%
mutate(s = str_to_upper(str_trim(geslacht))) %>%
group_by(bird_id) %>%
summarise(
chick_sex = case_when(
any(s == "F", na.rm = TRUE) & any(s == "M", na.rm = TRUE)   ~ "U",
any(s == "F", na.rm = TRUE)                                  ~ "F",
any(s == "M", na.rm = TRUE)                                  ~ "M",
any(s == "FU", na.rm = TRUE) & any(s == "MU", na.rm = TRUE) ~ "U",
any(s == "FU", na.rm = TRUE)                                 ~ "Fu",
any(s == "MU", na.rm = TRUE)                                 ~ "Mu",
TRUE                                                         ~ "U"
),
.groups = "drop"
)
# Sex from adult sightings (years after the ringing year)
sex_adult <- observations %>%
mutate(year = as.numeric(year),
s    = str_to_upper(str_trim(obs_sex))) %>%
inner_join(birds, by = "bird_id") %>%
filter(year > ringing_year, s %in% c("F", "M")) %>%
group_by(bird_id) %>%
summarise(
n_F = sum(s == "F"),
n_M = sum(s == "M"),
adult_sex = case_when(n_F > n_M & n_F >= 2 ~ "F",
n_M > n_F & n_M >= 2 ~ "M",
TRUE ~ NA_character_),   # fall back to chick sex
.groups = "drop"
)
# Combine: adult sex wins, otherwise keep chick sex
sex_info <- sex_chick %>%
left_join(sex_adult, by = "bird_id") %>%
mutate(
sex        = coalesce(adult_sex, chick_sex),
sex_source = ifelse(!is.na(adult_sex), "adult", "chick")
)
# Birds whose sex changed because of the adult sightings --> check these
sex_changed <- sex_info %>%
filter(sex_source == "adult", chick_sex != sex) %>%
select(bird_id, chick_sex, adult_sex, n_F, n_M)
print(sex_changed, n = Inf)
cmr <- cmr %>%
left_join(sex_info %>% select(bird_id, sex), by = "bird_id")
table(cmr$sex, useNA = "always")
# Filter out birds with U, Mu or Fu sex
cmr <- cmr %>%
filter(sex %in% c("F", "M"))
# Now add ring central
centre_info <- chick_master %>%
select(bird_id, ringcentrale) %>%
mutate(centre = factor(ringcentrale, levels = c("NLA", "DEW"))) %>%
select(bird_id, centre)
cmr <- cmr %>%
left_join(centre_info, by = "bird_id")
table(cmr$centre, cmr$tag_type, useNA = "always")
# ==========================================================
# 14. Check the resulting dataset and get started with rmark analysis looking at how factors affect survival and reencounters
cmr <- cmr %>%
mutate(freq = 1)
# mark has a problem with running the tag_type variable due to variable names that are too elaborate - i.e. including a space so fix
cmr <- cmr %>%
mutate(tag_type = case_when(tag_type == 'colour ring' ~ 'color',
tag_type == 'metal ring' ~ 'metal',
tag_type == 'wingtag' ~ 'wingtag'),
centre = as.factor(centre),
tag_type = as.factor(tag_type),
sex = as.factor(sex))
cmr.process <- process.data(cmr, begin.time = min(years), # not really important here, but will be important to determine when working with vole data, then starting from 2012
groups = c('sex', 'tag_type', "centre"), # individual variables that are categorical need to be added here
model = 'CJS')
# ddl = design data list
cmr.ddl <- make.design.data(cmr.process)
# juvenile 0-1, subadult >1 - 2; adult >2, therefore bis are 0,1,2, max age
cmr.ddl <- add.design.data(cmr.process, cmr.ddl, parameter = 'Phi',
type = 'age', bins = c(0, 1, 2, 100), # 6 being the max age in the dataset
name ='ageclass',
replace = T, # replaces an existing variable
right = F) # makes the interval closed on the left. Default is x in (x1, x2] meaning x1 < x <= x2, but what I want is [x1, x2) which is x1 <= x < x2
cmr.ddl <- add.design.data(cmr.process, cmr.ddl, parameter = 'p', # different parameter
type = 'age', bins = c(1, 2, 100),
name = 'ageclass',
replace = T,
right = F)
# checking the structure of the designed Phi parameter
str(cmr.ddl$Phi)
# 15. CJS MODELS: EFFECT OF AGE -> definitely include
cmr.age.models <- function(){
# apparent survival Phi
Phi.dot <- list(formula = ~ 1) # constant survival
Phi.age <- list(formula = ~ ageclass) # depends on ageclass
# probability of reencounter p
p.dot <- list(formula = ~ 1)
p.age <- list(formula = ~ ageclass) # depends on ageclass
cml.age <- create.model.list('CJS')
results <- mark.wrapper(cml.age, data = cmr.process, ddl = cmr.ddl)
return(results)
}
cmr.age.results <- cmr.age.models()
cmr.age.results
cmr.age.results$Phi.age.p.age$results$beta
cmr.age.results$Phi.dot.p.age$results$real
# CONCLUSION: age both phi and p (singular)!
