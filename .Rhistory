p.Time       <- list(formula = ~Time)
p.ageclass   <- list(formula = ~ageclass)
p.tag        <- list(formula = ~tag_type)
p.tag.Time   <- list(formula = ~tag_type + Time)
p.tag.t.Time <- list(formula = ~tag_type * Time)
p.tag.centre <- list(formula = ~tag_type + centre)
p.centre     <- list(formula = ~tag_type + Time + centre)
p.tag.t.Time.centre <- list(formula = ~tag_type * Time + centre)
p.ageclass.tag <- list(formula = ~ageclass + tag_type)
p.ageclass.tag.Time <- list(formula = ~ageclass + tag_type + Time)
p.ageclass.tag.t.Time <- list(formula = ~ageclass + tag_type * Time)
p.ageclass.centre <- list(formula = ~ageclass + tag_type + Time + centre)
p.ageclass.centre.t <- list(formula = ~ageclass + tag_type * Time + centre)
cml <- create.model.list('CJS')
results <- mark.wrapper(cml, data = cmr.process, ddl = cmr.ddl)
return(results)
}
