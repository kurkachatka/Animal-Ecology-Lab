# 23. GOODNESS OF FIT, c-hat and MODEL AVERAGING - new method I found
gof_chat <- function(proc, split_by = "tag_type", drop_3sr = TRUE,
min_birds = 30) {
stopifnot(split_by %in% names(proc$data))
groups <- split(proc$data, droplevels(factor(proc$data[[split_by]])))
out <- lapply(names(groups), function(g) {
d <- groups[[g]]
if (nrow(d) < min_birds) {
message("skipping '", g, "': only ", nrow(d), " birds")
return(NULL)
}
X <- matrix(as.numeric(unlist(strsplit(d$ch, ""))),
nrow = nrow(d), byrow = TRUE)
f <- if ("freq" %in% names(d)) d$freq else rep(1, nrow(d))
t3sr <- test3sr(X, f); t3sm <- test3sm(X, f)
t2ct <- test2ct(X, f); t2cl <- test2cl(X, f)
data.frame(
group = g,
birds = nrow(d),
test  = c("3.SR", "3.SM", "2.CT", "2.CL"),
stat  = c(t3sr$test3sr["stat"], t3sm$test3sm["stat"],
t2ct$test2ct["stat"], t2cl$test2cl["stat"]),
df    = c(t3sr$test3sr["df"],   t3sm$test3sm["df"],
t2ct$test2ct["df"],   t2cl$test2cl["df"]),
p_val = c(t3sr$test3sr["p_val"], t3sm$test3sm["p_val"],
t2ct$test2ct["p_val"], t2cl$test2cl["p_val"]),
row.names = NULL
)
})
tests <- bind_rows(out)
if (nrow(tests) == 0) stop("no group had enough birds to test")
print(tests, digits = 3)
used <- if (drop_3sr) filter(tests, test != "3.SR") else tests
used <- filter(used, df > 0)
chat_raw  <- sum(used$stat) / sum(used$df)
chat_all  <- with(filter(tests, df > 0), sum(stat) / sum(df))
cat("\nsum chi-square:", round(sum(used$stat), 2),
" on", sum(used$df), "df\n")
cat("c-hat used   :", round(chat_raw, 3),
ifelse(drop_3sr, " (3.SR excluded)", ""), "\n")
cat("c-hat with 3.SR:", round(chat_all, 3), "\n")
if (chat_raw < 1) cat("c-hat below 1 -> using 1 (never deflate)\n")
if (chat_raw > 3) cat("WARNING: c-hat > 3. That is structural lack of fit,\n",
"not overdispersion. Check the model before adjusting.\n")
invisible(structure(max(chat_raw, 1), tests = tests))
}
# Full dataset
chat.cmr <- gof_chat(cmr.process)
chat.cmr
