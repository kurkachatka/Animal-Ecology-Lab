# 19. CJS Fuller set of models on the whole cmr dataset
cmr.models <- function(){
# apparent survival Phi
Phi.dot <- list(formula = ~1)
Phi.Time <- list(formula = ~Time)
Phi.ageclass <- list(formula = ~ageclass)
Phi.ageclass.sex <- list(formula = ~ageclass + sex)
Phi.ageclass.Time <- list(formula = ~ageclass + Time)
Phi.ageclass.sex.Time <- list(formula = ~ageclass + sex + Time)
# probability of rencountering p
p.dot        <- list(formula = ~1)
p.Time       <- list(formula = ~Time)
p.centre    <- list(formula = ~centre)
p.t.cente     <- list(formula = ~Time + centre)
p.tag        <- list(formula = ~tag_type)
p.tag.centre <- list(formula = ~tag_type + centre)
p.tag.Time   <- list(formula = ~tag_type + Time)
#p.tag.t.Time <- list(formula = ~tag_type * Time)
p.centre     <- list(formula = ~tag_type + Time + centre)
#p.tag.t.Time.centre <- list(formula = ~tag_type * Time + centre)
p.ageclass <- list(formula = ~ageclass)
p.ageclass.tag <- list(formula = ~ageclass + tag_type)
p.ageclass.Time <- list(formula = ~ageclass + Time)
p.ageclass.tag.Time <- list(formula = ~ageclass + tag_type + Time)
cml <- create.model.list('CJS')
results <- mark.wrapper(cml, data = cmr.process, ddl = cmr.ddl)
return(results)
}
